# ---- Provider API keys ----
ANTHROPIC_API_KEY=sk-ant-...
# Required if LLM_PROVIDER=gemini (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: only needed if you switch EMBEDDING_PROVIDER or LLM_PROVIDER to "openai"
OPENAI_API_KEY=

# ---- LLM ----
# anthropic | gemini | openai (openai not wired yet)
LLM_PROVIDER=anthropic
# anthropic: claude-opus-4-7   |   gemini: gemini-2.5-flash
LLM_MODEL=claude-opus-4-7
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ---- Embeddings ----
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Vector store ----
VECTOR_STORE_PATH=./.chroma
VECTOR_STORE_COLLECTION=rag_chunks

# ---- Uploads ----
UPLOADS_PATH=./uploads

# ---- Chunking ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----
TOP_K=5
HYBRID_SEARCH=false
RRF_K=60

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000

# ---- Logging ----
LOG_LEVEL=INFO
